# ---------------------------------------------------------------- site
NEXT_PUBLIC_SITE_URL=https://10xdrink.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@10xdrink.com
# Digits only, no "+" — used by the support widget's WhatsApp link.
# NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999

# --------------------------------------------------------------- admin
# REQUIRED IN PRODUCTION. Signs the admin session cookie; min 16 chars.
# Generate one with:  openssl rand -base64 32
# Without it the admin panel refuses to start in production.
ADMIN_SESSION_SECRET=

# Who can sign in. Prefer the hash over the plaintext password.
# Generate the hash with:  printf '%s' 'your-password' | shasum -a 256
ADMIN_EMAIL=admin@10xdrink.com
ADMIN_PASSWORD_SHA256=
# ADMIN_PASSWORD=            # plaintext fallback — avoid outside local dev
ADMIN_NAME=Store Admin

# In development only, an unconfigured panel accepts
# admin@10xdrink.com / 10xadmin so the UI can be worked on.
# In production, an unconfigured panel rejects every login.
