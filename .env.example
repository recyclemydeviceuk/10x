# =============================================================
# 10X STOREFRONT — environment (copy to .env.local)
#
# The storefront runs on port 3000 (`npm run dev`).
# =============================================================

# --------------------------------------------------------------- site
# Canonical site URL — used in metadata, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://10xdrink.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@10xdrink.com
# Digits only, no "+" — used by the support widget's WhatsApp link.
# NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999
# Google Search Console verification token (optional).
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ----------------------------------------------------- backend server
# The 10X API (server/). EVERYTHING dynamic on this site comes from it:
# the catalogue and prices, store settings, coupons, checkout and
# payment, the account area, subscriptions, returns and the contact
# form.
#
# NEXT_PUBLIC_ because the browser calls it directly — the customer's
# session is an HttpOnly API cookie, and the API is the security boundary. Set
# CORS_ORIGINS in server/.env to this site's origin.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ------------------------------------------------------------- media
# Hostname product images are served from (the S3 bucket or CDN behind
# the API's S3_PUBLIC_BASE_URL). next/image refuses remote images from
# hosts it hasn't been told about, so product photos won't render
# until this matches.
# NEXT_PUBLIC_MEDIA_HOST=media.10xdrink.com
